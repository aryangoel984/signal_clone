# SQLite file used by the backend (async driver)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Demo bots auto-reply to messages (see docs/PLAN.md section 8)
DEMO_BOTS_ENABLED=true
DEMO_BOT_PHONES=+15550000001,+15550000002
# Multiplies the bots' reply delays (0 = instant)
DEMO_BOT_DELAY_SCALE=1.0

# Backend uploads location (served at /media)
UPLOADS_DIR=uploads

# Session lifetime
SESSION_TTL_DAYS=30
